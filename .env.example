# ============================================
# LegalAssistant 环境变量示例
# ============================================
# 1. 复制为 .env
# 2. 根据你要运行的模式填写变量
# 3. 推荐：
#    - 云端演示：SPRING_PROFILES_ACTIVE=demo + DeepSeek
#    - 本地复现：默认配置 + Ollama + PostgreSQL/PGVector
# ============================================

# ==================== 运行模式 ====================
# 可选：demo（云端演示） / 留空（本地复现）
SPRING_PROFILES_ACTIVE=

# ==================== API 密钥 ====================
# 云端演示建议配置 DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 可选：显示控制 DeepSeek 开关；若留空，启动脚本会自动判断
DEEPSEEK_CHAT_ENABLED=

# 可选：demo 模式下指定聊天模型
DEMO_CHAT_MODEL=deepseek-chat

# ==================== JWT 配置 ====================
JWT_SECRET=your_jwt_secret_key_here

# ==================== 数据库配置 ====================
DATABASE_URL=jdbc:postgresql://localhost:5432/legal_assistant
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password_here

# ==================== 管理员配置 ====================
ADMIN_PASSWORD=your_admin_password_here

# ==================== Ollama（本地复现） ====================
# 本地模式建议准备聊天模型和 embedding 模型
OLLAMA_BASE_URL=http://localhost:11434

# ==================== 文件上传 ====================
# UPLOAD_PATH=/opt/legal-assistant/uploads

# ==================== SQL 调试 ====================
DB_DEBUG_SHOW_SQL=false
DB_DEBUG_FORMAT_SQL=false
DB_DEBUG_SHOW_PARAMS=false

